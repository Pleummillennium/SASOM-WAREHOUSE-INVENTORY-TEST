generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Order {
  id          Int     @id @default(autoincrement())
  orderId     String  @unique
  productName String
  price       Float
  category    String
  boxHeight   Float

  allocation SlotAllocation?

  @@map("orders")
}

model Shelf {
  id           Int     @id @default(autoincrement())
  shelfCode    String  @unique
  category     String
  minBoxHeight Float?
  maxBoxHeight Float?
  totalLevels  Int     @default(7)
  slotHeight   Float
  totalSlots   Int     @default(50)

  allocations SlotAllocation[]

  @@map("shelves")
}

model SlotAllocation {
  id          Int      @id @default(autoincrement())
  orderId     String   @unique
  shelfCode   String
  level       Int
  slot        Int
  allocatedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [orderId])
  shelf Shelf @relation(fields: [shelfCode], references: [shelfCode])

  @@map("slot_allocations")
}

// ติดตามสถานะของการรัน Allocation แต่ละครั้ง
// ใช้เพื่อ detect ว่า server crash ระหว่างรันหรือเปล่า
// ถ้า restart มาแล้วเห็น status = RUNNING แสดงว่า crash กลางทาง
model AllocationRun {
  id         Int       @id @default(autoincrement())
  status     String    // RUNNING | DONE | FAILED
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  allocated  Int?
  skipped    Int?
  error      String?   // เก็บ error message ถ้า status = FAILED

  @@map("allocation_runs")
}
